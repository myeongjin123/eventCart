# deploy/.env 로 복사해서 값을 채운다. .env는 git에 올리지 않는다.

MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Base64 문자열, 디코딩 후 32바이트 이상. 생성: openssl rand -base64 48
JWT_SECRET=

# 첫 관리자 계정 (비우면 만들지 않음)
ADMIN_EMAIL=admin@eventcart.dev
ADMIN_PASSWORD=change-me-admin

GRAFANA_ADMIN_PASSWORD=change-me-grafana

# 선택: GHCR에 올린 이미지를 쓸 때 (예: ghcr.io/myeongjin123/eventcart:latest). 비우면 소스로 빌드
APP_IMAGE=
